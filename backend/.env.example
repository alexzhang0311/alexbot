# ── Development (SQLite, no Docker needed) ──
# Copy this file to .env and adjust as needed
#   cp .env.example .env
#
# 生产环境请设置 ENVIRONMENT=production 并配置 PostgreSQL

ENVIRONMENT=development
SECRET_KEY=dev-secret-key-change-in-production

# 开发模式自动使用 SQLite，无需手动配置
# 开发模式无需 Redis

# LLM
DEFAULT_MODEL=MiniMax-M2.7
OPENAI_API_KEY=

# Logging
# 默认: development=DEBUG, production=INFO
# LOG_LEVEL 为空时按 ENVIRONMENT 自动选择
LOG_LEVEL=
LOG_LEVEL_DEV=DEBUG
LOG_LEVEL_PROD=INFO
LOG_DIR=logs
LOG_ROTATION=1 day
LOG_RETENTION=14 days
LOG_SERIALIZE=false
